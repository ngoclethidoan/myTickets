# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# Aiven connection (Overview page of your MySQL service)
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
# Path to the CA certificate downloaded from the Aiven console (ca.pem). Leave empty for a local database.
DB_SSL_CA=ca.pem

# Database names
MAIN_DB=myv_myTickets
ADMIN_DB=myv_myTickets_admin

# The two limited accounts created by security/01_accounts_and_grants.sql
CUSTOMER_APP_PASSWORD=
ADMIN_APP_PASSWORD=

# Only used by create_admin.py, never by the web app
OWNER_USER=avnadmin
OWNER_PASSWORD=
